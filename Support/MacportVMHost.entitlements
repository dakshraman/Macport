<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Entitlements for MacportVMHost — the per-VM process that owns QEMU.

	  This file is not attached to a target yet: the host target lands in
	  Workstream C of docs/REFACTOR-PLAN.md. It exists now so the privilege
	  boundary is explicit and reviewable before the process exists.

	  Placement follows the measured Parallels split (see
	  docs/evidence/parallels-refactor-2026-10-19.md): the GUI carries none of
	  these; the per-VM process carries all of them.
	-->

	<!-- QEMU's `-accel hvf` drives Hypervisor.framework. The vendored QEMU
	     binaries are already ad-hoc signed with this entitlement by
	     QEMURuntimeBundler; the host needs it when it links the framework
	     itself and for a future in-process backend. -->
	<key>com.apple.security.hypervisor</key>
	<true/>

	<!--
	  Restricted grants. Uncomment ONLY when an Apple-issued provisioning
	  profile authorises them; codesign and AMFI will reject them otherwise,
	  and a signing failure here is a missing grant, not a code bug.

	  com.apple.vm.networking     -> bridged networking via vmnet
	  com.apple.vm.device-access  -> USB and host device passthrough
	-->
	<!--
	<key>com.apple.vm.networking</key>
	<true/>
	<key>com.apple.vm.device-access</key>
	<true/>
	-->
</dict>
</plist>
